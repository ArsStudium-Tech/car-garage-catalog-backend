generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Garage {
  id             String   @id @default(uuid())
  name           String
  domain         String   @unique
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  whatsapp       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  bairro         String?  @map("bairro")
  cidade         String?  @map("cidade")
  estado         String?  @map("estado")
  latitude       Float?   @map("latitude")
  logradouro     String?  @map("logradouro")
  longitude      Float?   @map("longitude")
  numero         String?  @map("numero")
  cars           Car[]
  users          User[]

  @@map("garage")
}

model User {
  id        String   @id @default(uuid())
  garageId  String   @map("garage_id")
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([email])
  @@map("user")
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cars      Car[]

  @@map("brand")
}

model Car {
  id           String    @id @default(uuid())
  garageId     String    @map("garage_id")
  brandId      String    @map("brand_id")
  model        String
  year         Int
  price        Int
  mileage      Int?
  description  String?
  status       CarStatus @default(AVAILABLE)
  images       String[]  @default([])
  fuel         String?   @map("fuel")
  color        String?   @map("color")
  transmission String?   @map("transmission")
  licensePlate String?   @map("license_plate")
  financeable  Boolean   @default(false) @map("financeable")
  options      Json?     @map("options")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  brand        Brand     @relation(fields: [brandId], references: [id])
  garage       Garage    @relation(fields: [garageId], references: [id], onDelete: Cascade)

  @@index([garageId])
  @@index([brandId])
  @@index([status])
  @@map("car")
}

enum CarStatus {
  AVAILABLE
  SOLD

  @@map("car_status")
}

enum UserRole {
  ADMIN
  MANAGER

  @@map("user_role")
}
